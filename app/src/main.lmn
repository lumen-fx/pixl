<root id="app" class="pixl dark">
  <row id="menubar">
    <label class="brand" text="pixl"/>
    <tooltip text="Back to the start screen"><button id="go-home" class="menu-title" text="Home"/></tooltip>
    <button id="menu-file" class="menu-title" text="File"/>
    <menu id="file-menu">
      <menuitem id="file-new" label="New... (Ctrl+N)"/>
      <menuitem id="file-open" label="Open... (Ctrl+O)"/>
      <separator/>
      <menuitem id="file-save" label="Save (Ctrl+S)"/>
      <menuitem id="file-save-as" label="Save as... (Ctrl+Shift+S)"/>
      <separator/>
      <menuitem id="file-export-png" label="Export PNG... (Ctrl+E)"/>
      <menuitem id="file-export-gif" label="Export GIF..."/>
      <separator/>
      <menuitem id="file-close" label="Close (Ctrl+W)"/>
    </menu>
    <button id="menu-edit" class="menu-title" text="Edit"/>
    <menu id="edit-menu">
      <menuitem id="undo" label="Undo"/>
      <menuitem id="redo" label="Redo"/>
      <separator/>
      <menuitem id="edit-settings" label="Settings..."/>
    </menu>
    <button id="menu-view" class="menu-title" text="View"/>
    <button id="menu-layer" class="menu-title" text="Layer"/>
    <button id="menu-window" class="menu-title" text="Window"/>
    <include src="parts/window-menu.lmn"/>
    <spacer/>
    <label id="doc-title" class="doc-title" bind-text="doc_title" text="untitled"/>
    <spacer/>
    <button id="toggle-font" class="flat" text="Plain font"/>
    <button id="toggle-theme" class="flat" text="Light"/>
  </row>

  <row id="tool-options">
    <label id="tool-name" class="tool-name" bind-text="tool_label" text="Pencil"/>
    <if signal="show_size" mode="hide">
      <row class="option">
        <label class="option-label" text="Size"/>
        <slider id="opt-size" class="option-slider" min="1" max="32" step="1" value="1" bind-value="opt_size"/>
        <label class="option-value" bind-text="opt_size_text" text="1 px"/>
      </row>
    </if>
    <if signal="show_pixel_perfect" mode="hide">
      <checkbox id="opt-pixel-perfect" label="Pixel perfect" checked="true" bind-checked="opt_pixel_perfect"/>
    </if>
    <if signal="show_pressure" mode="hide">
      <checkbox id="opt-pressure" label="Pressure size" checked="true" bind-checked="opt_pressure"/>
    </if>
    <if signal="show_filled" mode="hide">
      <checkbox id="opt-filled" label="Filled" bind-checked="opt_filled"/>
    </if>
    <if signal="show_bucket" mode="hide">
      <row class="option">
        <label class="option-label" text="Tolerance"/>
        <slider id="opt-tolerance" class="option-slider" min="0" max="255" step="1" value="0" bind-value="opt_tolerance"/>
        <label class="option-value" bind-text="opt_tolerance_text" text="0"/>
      </row>
      <checkbox id="opt-contiguous" label="Contiguous" checked="true" bind-checked="opt_contiguous"/>
    </if>
    <label id="tool-hint" class="option-label" bind-text="tool_hint" text=""/>
  </row>

  <row id="workspace">
    <column id="toolbar">
      <tooltip text="Pencil (B)"><button id="tool-pencil" class="tool active" text=""><tile class="tool-icon icon-pencil"/></button></tooltip>
      <tooltip text="Eraser (E)"><button id="tool-eraser" class="tool" text=""><tile class="tool-icon icon-eraser"/></button></tooltip>
      <tooltip text="Line (L)"><button id="tool-line" class="tool" text=""><tile class="tool-icon icon-line"/></button></tooltip>
      <tooltip text="Rectangle (U)"><button id="tool-rect" class="tool" text=""><tile class="tool-icon icon-rect"/></button></tooltip>
      <tooltip text="Ellipse (Shift+U)"><button id="tool-ellipse" class="tool" text=""><tile class="tool-icon icon-ellipse"/></button></tooltip>
      <tooltip text="Bucket (G)"><button id="tool-bucket" class="tool" text=""><tile class="tool-icon icon-bucket"/></button></tooltip>
      <tooltip text="Eyedropper (I)"><button id="tool-eyedropper" class="tool" text=""><tile class="tool-icon icon-eyedropper"/></button></tooltip>
      <tooltip text="Rectangle select (M)"><button id="tool-select" class="tool" text=""><tile class="tool-icon icon-select"/></button></tooltip>
      <tooltip text="Move (V)"><button id="tool-move" class="tool" text=""><tile class="tool-icon icon-move"/></button></tooltip>
    </column>

    <split id="docks" class="docks">
    <column id="dock-left" class="dock side empty"/>
    <split id="center">
    <column id="stage">
      <canvas id="checker"/>
      <canvas id="art"/>
      <canvas id="overlay"/>
    </column>
    <column id="dock-bottom" class="dock empty"/>
    </split>

    <column id="dock-right" class="dock side">
      <column id="panel-color" class="panel">
        <row class="panel-header"><label class="panel-title" text="Color"/></row>
        <column id="color-body" class="panel-body">
          <row class="color-pair">
            <tile id="color-fg" class="swatch big"/>
            <tile id="color-bg" class="swatch big back"/>
            <button id="color-swap" class="flat small" text="Swap"/>
            <spacer/>
            <input id="color-hex" class="hex" bind-text="color_hex" text="#000000"/>
          </row>
          <row class="channel"><label class="channel-name" text="R"/><slider id="color-r" class="channel-slider" min="0" max="255" step="1" value="0" bind-value="color_r"/><label class="channel-value" bind-text="color_r_text" text="0"/></row>
          <row class="channel"><label class="channel-name" text="G"/><slider id="color-g" class="channel-slider" min="0" max="255" step="1" value="0" bind-value="color_g"/><label class="channel-value" bind-text="color_g_text" text="0"/></row>
          <row class="channel"><label class="channel-name" text="B"/><slider id="color-b" class="channel-slider" min="0" max="255" step="1" value="0" bind-value="color_b"/><label class="channel-value" bind-text="color_b_text" text="0"/></row>
          <row class="channel"><label class="channel-name" text="A"/><slider id="color-a" class="channel-slider" min="0" max="255" step="1" value="255" bind-value="color_a"/><label class="channel-value" bind-text="color_a_text" text="255"/></row>
        </column>
      </column>
      <column id="panel-palette" class="panel">
        <row class="panel-header"><label class="panel-title" text="Palette"/></row>
        <column id="palette-body" class="panel-body">
          <row id="palette-swatches" class="swatches"/>
        </column>
      </column>
      <column id="panel-layers" class="panel fill">
        <row class="panel-header"><label class="panel-title" text="Layers"/></row>
        <column id="layers-body" class="panel-body fill">
          <row class="layer-props">
            <dropdown id="layer-blend" class="blend" bind-value="layer_blend">
              <option value="Normal"/>
              <option value="Multiply"/>
              <option value="Screen"/>
              <option value="Overlay"/>
              <option value="Darken"/>
              <option value="Lighten"/>
              <option value="Color dodge"/>
              <option value="Color burn"/>
              <option value="Hard light"/>
              <option value="Soft light"/>
              <option value="Difference"/>
              <option value="Exclusion"/>
              <option value="Hue"/>
              <option value="Saturation"/>
              <option value="Color"/>
              <option value="Luminosity"/>
              <option value="Add"/>
              <option value="Subtract"/>
            </dropdown>
            <slider id="layer-opacity" class="opacity-slider" min="0" max="100" step="1" value="100" bind-value="layer_opacity"/>
            <label class="channel-value" bind-text="layer_opacity_text" text="100%"/>
          </row>
          <scroll id="layer-list" class="layer-list"/>
          <row class="layer-actions">
            <tooltip text="New layer"><button id="layer-add" class="flat small" text="New"/></tooltip>
            <tooltip text="Delete layer"><button id="layer-delete" class="flat small" text="Delete"/></tooltip>
            <spacer/>
            <tooltip text="Move up"><button id="layer-up" class="flat small" text="Up"/></tooltip>
            <tooltip text="Move down"><button id="layer-down" class="flat small" text="Down"/></tooltip>
          </row>
        </column>
      </column>
      <column id="panel-history" class="panel">
        <row class="panel-header">
          <label class="panel-title" text="History"/>
          <spacer/>
          <button id="history-undo" class="flat small" text="Undo"/>
          <button id="history-redo" class="flat small" text="Redo"/>
        </row>
        <column id="history-body" class="panel-body">
          <scroll id="history-list" class="history-list" bind-scroll="history_scroll"/>
        </column>
      </column>
    </column>
    </split>
  </row>

  <include src="parts/workspace.lmn"/>
  <include src="parts/themes.lmn"/>

  <dialog open="new_open">
    <column class="dialog-card new-card">
      <label class="dialog-title" text="New project"/>
      <row class="dialog-row">
        <label class="field-label" text="Name"/>
        <input id="new-name" class="name-field" bind-text="new_name" text="untitled"/>
      </row>
      <row class="dialog-row">
        <label class="field-label" text="Size"/>
        <input id="new-width" class="size-field" bind-text="new_width" text="64"/>
        <label class="option-label" text="x"/>
        <input id="new-height" class="size-field" bind-text="new_height" text="64"/>
        <label class="option-label" text="px"/>
      </row>
      <row class="dialog-row presets">
        <label class="field-label" text="Square"/>
        <button id="preset-16x16" class="preset" text="16"/><button id="preset-32x32" class="preset" text="32"/><button id="preset-64x64" class="preset" text="64"/><button id="preset-128x128" class="preset" text="128"/><button id="preset-256x256" class="preset" text="256"/><button id="preset-512x512" class="preset" text="512"/>
      </row>
      <row class="dialog-row presets">
        <label class="field-label" text="Sprite"/>
        <tooltip text="Small character"><button id="preset-16x24" class="preset" text="16x24"/></tooltip><tooltip text="Character"><button id="preset-24x32" class="preset" text="24x32"/></tooltip><tooltip text="Tall character"><button id="preset-32x48" class="preset" text="32x48"/></tooltip><tooltip text="Large sprite"><button id="preset-48x48" class="preset" text="48x48"/></tooltip>
      </row>
      <row class="dialog-row presets">
        <label class="field-label" text="Screen"/>
        <tooltip text="Game Boy screen"><button id="preset-160x144" class="preset" text="160x144"/></tooltip><tooltip text="SNES screen"><button id="preset-256x224" class="preset" text="256x224"/></tooltip><tooltip text="NES screen"><button id="preset-256x240" class="preset" text="256x240"/></tooltip><tooltip text="16:9 low resolution"><button id="preset-320x180" class="preset" text="320x180"/></tooltip><tooltip text="4:3 low resolution"><button id="preset-320x240" class="preset" text="320x240"/></tooltip><tooltip text="16:9 screen"><button id="preset-640x360" class="preset" text="640x360"/></tooltip>
      </row>
      <row class="dialog-row">
        <label class="field-label" text="Color mode"/>
        <dropdown id="new-mode" class="new-choice" bind-value="new_mode">
          <option value="RGBA"/>
          <option value="Indexed"/>
        </dropdown>
      </row>
      <row class="dialog-row">
        <label class="field-label" text="Background"/>
        <dropdown id="new-background" class="new-choice" bind-value="new_background">
          <option value="Transparent"/>
          <option value="Color"/>
        </dropdown>
        <if signal="new_bg_color" mode="hide">
          <tile id="new-bg-swatch" class="swatch"/>
          <input id="new-bg-hex" class="hex" bind-text="new_bg_hex" text="#ffffff"/>
        </if>
      </row>
      <row class="dialog-actions">
        <spacer/>
        <button id="new-cancel" text="Cancel"/>
        <button id="new-create" class="primary" default="true" text="Create"/>
      </row>
    </column>
  </dialog>

  <include src="parts/settings.lmn"/>

  <dialog open="discard_open">
    <column class="dialog-card">
      <label class="dialog-title" text="Discard unsaved changes?"/>
      <label class="dialog-text" text="The document has edits that are not saved."/>
      <row class="dialog-actions">
        <spacer/>
        <button id="discard-no" text="Keep editing"/>
        <button id="discard-yes" class="primary" default="true" text="Discard"/>
      </row>
    </column>
  </dialog>

  <dialog open="recover_open">
    <column class="dialog-card">
      <label class="dialog-title" text="Recover unsaved edits?"/>
      <label class="dialog-text" text="An autosaved copy of this document is newer than the file."/>
      <row class="dialog-actions">
        <spacer/>
        <button id="recover-no" text="Open the file"/>
        <button id="recover-yes" class="primary" default="true" text="Recover"/>
      </row>
    </column>
  </dialog>

  <column id="home">
    <row class="home-top">
      <label class="home-brand" text="pixl"/>
      <label class="home-tagline" text="pixel art editor"/>
      <spacer/>
      <if signal="home_can_return" mode="hide">
        <button id="home-back" class="flat" text="Back to the editor"/>
      </if>
    </row>
    <row class="home-main">
      <column class="home-actions">
        <button id="home-new" class="primary home-action" text="New project..."/>
        <button id="home-open" class="home-action" text="Open..."/>
        <label class="home-hint" text="pixl, Aseprite, PNG and GIF files"/>
        <spacer/>
        <label id="home-message" class="home-message" bind-text="status_message" text=""/>
      </column>
      <column class="home-recents">
        <row class="home-recents-head">
          <label class="home-section" text="Recent"/>
          <spacer/>
          <input id="home-search" class="home-search" placeholder="Search" bind-text="home_filter" text=""/>
        </row>
        <scroll id="recent-list" class="recent-list"/>
      </column>
    </row>
  </column>

  <tile id="probes" class="probe">
    <tile id="probe-checker-a"/>
    <tile id="probe-checker-b"/>
    <tile id="probe-grid"/>
    <tile id="probe-marquee-a"/>
    <tile id="probe-marquee-b"/>
    <tile id="probe-preview"/>
    <tile id="probe-curve"/>
    <tile id="probe-curve-grid"/>
  </tile>

  <row id="statusbar">
    <label id="status-pos" class="status" bind-text="status_pos" text="-"/>
    <label id="status-color" class="status" bind-text="status_color" text="-"/>
    <label id="status-size" class="status" bind-text="status_size" text="-"/>
    <label id="status-message" class="status message" bind-text="status_message" text=""/>
    <spacer/>
    <label id="status-zoom" class="status" bind-text="status_zoom" text="100%"/>
  </row>
</root>
